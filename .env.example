# URL base de la aplicación (para los redirects interactivos de GNAP)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Configuración del Receptor (Campesino / Productor Rural)
BIOTAFLOW_URL_RECEPTOR=https://ilp.interledger-test.dev/pagos-entrada
BIOTAFLOW_KEY_ID_RECEPTOR=your-receptor-key-id
BIOTAFLOW_PRIVATE_KEY_PATH_RECEPTOR=./biotaflow-sdk/auth/private.pem

# Configuración del Donante / Emisor (Billetera de fondos en EUR/USD)
BIOTAFLOW_URL_DONANTE=https://ilp.interledger-test.dev/225f757
BIOTAFLOW_KEY_ID_DONANTE=your-donante-key-id
BIOTAFLOW_PRIVATE_KEY_PATH_DONANTE=./biotaflow-sdk/auth/private-emisor.pem
